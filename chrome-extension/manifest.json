{
  "manifest_version": 3,
  "name": "JSON Tools - JSON可视化工具",
  "version": "1.0.0",
  "description": "自动检测浏览器中的JSON数据并使用JSON Tools进行可视化展示",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "JSON Tools",
    "default_icon": {
      "64": "pwa-64x64.png",
      "96": "pwa-96x96.png",
      "192": "pwa-192x192.png",
      "512": "pwa-512x512.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "64": "pwa-64x64.png",
    "96": "pwa-96x96.png",
    "192": "pwa-192x192.png",
    "512": "pwa-512x512.png"
  }
}